# Copier ce fichier en .env pour changer une valeur. Toutes ont une valeur par défaut dans config.py.
# Les chemins relatifs partent de la racine du projet (Astro/).

# Logging
LOG_LEVEL=INFO
API_LOG_FILE=logs/api/api.log

# Simulation
ENV_ID=LunarLander-v3

# Modèle
MODEL_PATH=models/eagle1_final.zip
MODEL_VERSION=1.0.0

# Données de l'API
DATABASE_PATH=data/parties.db
VIDEOS_PATH=data/videos
VIDEO_FPS=50
MAX_EPISODES_EVALUATE=200

# Serveur API
API_HOST=127.0.0.1
API_PORT=8000
API_URL=http://127.0.0.1:8000
